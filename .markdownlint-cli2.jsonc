{
  "config": {
    "MD013": false,
    // Keep a Changelog repeats "Added" and "Changed" under each release.
    "MD024": { "siblings_only": true },
    // The README hero, collapsible sections and diagram images use a few HTML elements.
    "MD033": { "allowed_elements": ["div", "p", "img", "picture", "source", "sub", "code", "a", "details", "summary", "b", "br"] }
  },
  "ignores": [".venv/**", "node_modules/**", "out/**", "data/**"]
}
