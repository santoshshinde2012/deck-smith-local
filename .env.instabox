# Lean settings for a 4 vCPU / 8 GB InstaBox VM (no secrets here; copy to .env).
# Fake LLM by default: the full graph runs end to end without model keys. To use a remote model,
# set DECKSMITH_LLM=portkey and put provider keys in the InstaBox vault, never in this file.
DECKSMITH_LLM=fake
DECKSMITH_DATA_SOURCE=duckdb
DECKSMITH_CATALOG=per_user_views
DECKSMITH_STATE_STORE=postgres
DECKSMITH_TRACER=mlflow
DECKSMITH_IDENTITY=static
DECKSMITH_POSTGRES_DSN=postgresql://decksmith:decksmith@localhost:5433/decksmith
DECKSMITH_MLFLOW_TRACKING_URI=http://localhost:5001
DECKSMITH_PORTKEY_BASE_URL=http://localhost:8787
DECKSMITH_LOG_LEVEL=INFO
POSTGRES_PASSWORD=decksmith
