# Copy to .env. Every adapter is chosen here (see src/decksmith/config.py). Defaults run fully offline.
DECKSMITH_LLM=fake                 # fake | portkey
DECKSMITH_DATA_SOURCE=duckdb       # duckdb | databricks
DECKSMITH_CATALOG=per_user_views   # per_user_views | uc_oss | unity_catalog
DECKSMITH_STATE_STORE=memory       # memory | postgres
DECKSMITH_TRACER=noop              # noop | mlflow
DECKSMITH_IDENTITY=static          # static | jwt | databricks_apps
DECKSMITH_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
DECKSMITH_LOG_JSON=true            # JSON lines with run_id; false for plain text

# Local stack (make up)
DECKSMITH_POSTGRES_DSN=postgresql://decksmith:decksmith@localhost:5433/decksmith
DECKSMITH_MLFLOW_TRACKING_URI=http://localhost:5001
DECKSMITH_PORTKEY_BASE_URL=http://localhost:8787
DECKSMITH_UC_OSS_URL=http://localhost:8081
POSTGRES_PASSWORD=decksmith
OBJECT_STORE_ACCESS_KEY=rustfsadmin
OBJECT_STORE_SECRET_KEY=rustfsadmin

# Only for identity=jwt (at least 32 characters; validated at start-up)
DECKSMITH_JWT_SECRET=

# Tier L3 (hybrid with a Databricks workspace). Never commit real values.
DECKSMITH_DATABRICKS_HOST=
DECKSMITH_DATABRICKS_WAREHOUSE_ID=
